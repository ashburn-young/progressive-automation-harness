      "properties": {
        "replicaCount": 1,
        "partitionCount": 1,
        "hostingMode": "default",
        "publicNetworkAccess": "[variables('publicAccess')]",
        "disableLocalAuth": true
      }
    },
    {
      "condition": "[parameters('deployRedis')]",
      "type": "Microsoft.Cache/redis",
      "apiVersion": "2024-03-01",
      "name": "[variables('redisName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "Basic",
          "family": "C",
          "capacity": 0
