      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy an Azure Functions app for skill execution."
      }
    },
    "apimPublisherEmail": {
      "type": "string",
      "defaultValue": "admin@mngenvmcap999938.onmicrosoft.com",
      "metadata": {
        "description": "Publisher email for API Management (required if deployApim)."
      }
    },
    "apimPublisherName": {
      "type": "string",
      "defaultValue": "TakeMyJob",
      "metadata": {
        "description": "Publisher name for API Management."
      }
    },
    "lockDownPublicAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Disable public network access on Cosmos/Search once the orchestrator runs inside the VNet. Leave false while the harness runs outside Azure."
      }
    }
  },
  "variables": {
    "publicAccess": "[if(parameters('lockDownPublicAccess'), 'Disabled', 'Enabled')]",
    "suffix": "[uniqueString(resourceGroup().id)]",
    "laName": "[format('{0}-law-{1}', parameters('namePrefix'), variables('suffix'))]",
    "uamiName": "[format('{0}-id-{1}', parameters('namePrefix'), variables('suffix'))]",
    "acaEnvName": "[format('{0}-acaenv-{1}', parameters('namePrefix'), variables('suffix'))]",
    "orchestratorName": "[format('{0}-orchestrator', parameters('namePrefix'))]",
    "storageName": "[toLower(format('{0}st{1}', parameters('namePrefix'), variables('suffix')))]",
    "funcPlanName": "[format('{0}-funcplan-{1}', parameters('namePrefix'), variables('suffix'))]",
    "funcAppName": "[format('{0}-func-{1}', parameters('namePrefix'), variables('suffix'))]",
    "cosmosName": "[toLower(format('{0}-cosmos-{1}', parameters('namePrefix'), variables('suffix')))]",
    "searchName": "[toLower(format('{0}-search-{1}', parameters('namePrefix'), variables('suffix')))]",
    "redisName": "[toLower(format('{0}-redis-{1}', parameters('namePrefix'), variables('suffix')))]",
    "apimName": "[format('{0}-apim-{1}', parameters('namePrefix'), variables('suffix'))]",
    "acrName": "[toLower(format('{0}acr{1}', parameters('namePrefix'), variables('suffix')))]",
    "vnetName": "[format('{0}-vnet-{1}', parameters('namePrefix'), variables('suffix'))]",
    "peZones": [
