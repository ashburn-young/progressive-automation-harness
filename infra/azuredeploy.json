    },
    "existingAppInsightsName": {
      "type": "string",
      "defaultValue": "airgtakemyjob03b5ad",
      "metadata": {
        "description": "Existing Application Insights component name."
      }
    },
    "existingKeyVaultName": {
      "type": "string",
      "defaultValue": "kvrgtakemyjob03b5ad",
      "metadata": {
        "description": "Existing Key Vault name."
      }
    },
    "deployAiSearch": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Azure AI Search (Basic ~ paid). Long-term memory / RAG."
      }
    },
    "deployRedis": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy Azure Cache for Redis (Basic C0 ~ paid). Short-term state."
      }
    },
    "deployApim": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy API Management (Developer SKU ~ paid, slow to provision)."
      }
    },
