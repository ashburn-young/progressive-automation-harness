        "subscriptionRequired": true,
        "approvalRequired": false,
        "state": "published"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', variables('apimName'))]"
      ]
    },
    {
      "condition": "[parameters('deployApim')]",
      "type": "Microsoft.ApiManagement/service/products/policies",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('apimName'), 'ai-team', 'policy')]",
      "properties": {
        "format": "rawxml",
        "value": "<policies><inbound><rate-limit calls=\"60\" renewal-period=\"60\" /><quota calls=\"10000\" renewal-period=\"604800\" /></inbound><backend><forward-request /></backend><outbound /><on-error /></policies>"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/products', variables('apimName'), 'ai-team')]"
      ]
    },
    {
      "condition": "[parameters('deployApim')]",
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}/{1}', variables('apimName'), 'foundry')]",
      "properties": {
        "displayName": "Foundry Model",
        "path": "openai",
        "protocols": [
          "https"
        ],
        "serviceUrl": "https://takemyjob.services.ai.azure.com/api/projects/proj-default/openai/v1",
        "subscriptionRequired": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', variables('apimName'))]"
      ]
    },
    {
      "condition": "[parameters('deployApim')]",
      "type": "Microsoft.ApiManagement/service/apis/policies",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('apimName'), 'foundry', 'policy')]",
      "properties": {
        "format": "rawxml",
        "value": "<policies><inbound><base /><authentication-managed-identity resource=\"https://ai.azure.com\" /><rate-limit-by-key calls=\"30\" renewal-period=\"60\" counter-key=\"@(context.Subscription.Id)\" /></inbound><backend><forward-request /></backend><outbound /><on-error /></policies>"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', variables('apimName'), 'foundry')]"
      ]
    },
    {
      "condition": "[parameters('deployApim')]",
      "type": "Microsoft.ApiManagement/service/products/apis",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('apimName'), 'ai-team', 'foundry')]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', variables('apimName'), 'foundry')]",
        "[resourceId('Microsoft.ApiManagement/service/products', variables('apimName'), 'ai-team')]"
      ]
    },
    {
      "condition": "[parameters('deployApim')]",
      "type": "Microsoft.ApiManagement/service/subscriptions",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}/{1}', variables('apimName'), 'team-alpha')]",
