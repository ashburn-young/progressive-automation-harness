        "description": "Short prefix for resource names (lowercase)."
      }
    },
    "existingAiServicesName": {
      "type": "string",
      "defaultValue": "takemyjob",
      "metadata": {
        "description": "Existing AI Services (Foundry) account name - the model \"Brain\"."
