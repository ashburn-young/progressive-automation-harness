# --- Azure AI Foundry (preferred) -------------------------------------------
# OpenAI-compatible v1 base URL of your Foundry project. Auth is Azure AD via
# DefaultAzureCredential (az login / VS Code / managed identity) — no key here.
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1
AZURE_AI_DEPLOYMENT=gpt-4o-mini

# --- Plain OpenAI (fallback) ------------------------------------------------
# Used only if AZURE_AI_ENDPOINT is unset.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
